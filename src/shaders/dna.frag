#version 330 core

// ============================================================
// INPUT
// ============================================================

flat in uint baseType;

in vec2 localPosition;

in vec3 particleViewPosition;


// ============================================================
// UNIFORM
// ============================================================

uniform mat4 projection;

uniform float particleRadius;


// ============================================================
// OUTPUT
// ============================================================

out vec4 FragColor;


// ============================================================
// MAIN
// ============================================================

void main()
{
    // ========================================================
    // Distancia desde el centro del círculo
    // ========================================================

    float r2 =
        dot(
            localPosition,
            localPosition
        );


    // ========================================================
    // Fuera del círculo
    // ========================================================

    if (r2 > 1.0)
    {
        discard;
    }


    // ========================================================
    // ESFERA
    //
    // x² + y² + z² = 1
    //
    // Tomamos la parte frontal de la esfera.
    // ========================================================

    float sphereZ =
        sqrt(
            max(
                0.0,
                1.0 - r2
            )
        );


    // ========================================================
    // Punto sobre la esfera
    // ========================================================

    vec3 sphereNormal =
        normalize(
            vec3(
                localPosition,
                sphereZ
            )
        );


    // ========================================================
    // Posición real del fragmento
    // en VIEW SPACE
    // ========================================================

    vec3 fragmentViewPosition =
        particleViewPosition;


    fragmentViewPosition.xy +=
        localPosition *
        particleRadius;


    fragmentViewPosition.z -=
        sphereZ *
        particleRadius;


    // ========================================================
    // PROYECCIÓN
    // ========================================================

    vec4 clipPosition =
        projection *
        vec4(
            fragmentViewPosition,
            1.0
        );


    // ========================================================
    // DEPTH
    // ========================================================

    float ndcDepth =
        clipPosition.z /
        clipPosition.w;


    gl_FragDepth =
        ndcDepth *
        0.5 +
        0.5;


    // ========================================================
    // COLOR
    // ========================================================

    vec3 color;


    // --------------------------------------------------------
    // A
    // --------------------------------------------------------

    if (baseType == 65u)
    {
        color =
            vec3(
                1.0,
                0.10,
                0.10
            );
    }


    // --------------------------------------------------------
    // C
    // --------------------------------------------------------

    else if (baseType == 67u)
    {
        color =
            vec3(
                0.10,
                0.35,
                1.0
            );
    }


    // --------------------------------------------------------
    // G
    // --------------------------------------------------------

    else if (baseType == 71u)
    {
        color =
            vec3(
                0.10,
                0.90,
                0.20
            );
    }


    // --------------------------------------------------------
    // T
    // --------------------------------------------------------

    else
    {
        color =
            vec3(
                1.0,
                0.80,
                0.05
            );
    }


    // ========================================================
    // ILUMINACIÓN
    // ========================================================

    vec3 lightDirection =
        normalize(
            vec3(
                0.35,
                0.60,
                1.0
            )
        );


    float diffuse =
        max(
            dot(
                sphereNormal,
                lightDirection
            ),
            0.0
        );


    float ambient =
        0.20;


    float lighting =
        ambient +
        diffuse *
        0.80;


    // ========================================================
    // COLOR FINAL
    // ========================================================

    FragColor =
        vec4(
            color *
            lighting,
            1.0
        );
}
