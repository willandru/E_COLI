#version 330 core


// ============================================================
// INPUT
// ============================================================

flat in uint baseType;

in vec2 localPosition;


// ============================================================
// OUTPUT
// ============================================================

out vec4 FragColor;


// ============================================================
// MAIN
// ============================================================

void main()
{
    // ========================================================
    // Círculo
    // ========================================================

    float distance =
        length(localPosition);


    if (distance > 1.0)
    {
        discard;
    }


    // ========================================================
    // Esfera
    // ========================================================

    float z =
        sqrt(
            1.0 -
            distance * distance
        );


    vec3 normal =
        normalize(
            vec3(
                localPosition,
                z
            )
        );


    // ========================================================
    // Luz
    // ========================================================

    vec3 lightDirection =
        normalize(
            vec3(
                0.4,
                0.7,
                1.0
            )
        );


    float diffuse =
        max(
            dot(
                normal,
                lightDirection
            ),
            0.0
        );


    float ambient =
        0.25;


    float lighting =
        ambient +
        diffuse * 0.75;


    // ========================================================
    // Color de la base
    // ========================================================

    vec3 color;


    // A = ASCII 65
    if (baseType == 65u)
    {
        color =
            vec3(
                1.0,
                0.1,
                0.1
            );
    }

    // C = ASCII 67
    else if (baseType == 67u)
    {
        color =
            vec3(
                0.1,
                0.4,
                1.0
            );
    }

    // G = ASCII 71
    else if (baseType == 71u)
    {
        color =
            vec3(
                0.1,
                0.9,
                0.2
            );
    }

    // T = ASCII 84
    else
    {
        color =
            vec3(
                1.0,
                0.8,
                0.1
            );
    }


    // ========================================================
    // Resultado
    // ========================================================

    FragColor =
        vec4(
            color * lighting,
            1.0
        );
}