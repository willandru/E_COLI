#version 330 core

// ============================================================
// INPUT
// ============================================================

in vec3 fragmentNormal;


// ============================================================
// OUTPUT
// ============================================================

out vec4 FragColor;


// ============================================================
// UNIFORM
// ============================================================

uniform vec3 bondColor;


// ============================================================
// MAIN
// ============================================================

void main()
{
    // --------------------------------------------------------
    // Normalización
    // --------------------------------------------------------

    vec3 normal =
        normalize(
            fragmentNormal
        );


    // --------------------------------------------------------
    // Luz simple
    // --------------------------------------------------------

    vec3 lightDirection =
        normalize(
            vec3(
                0.5,
                1.0,
                0.8
            )
        );


    float diffuse =
        max(
            dot(
                normal,
                lightDirection
            ),
            0.0
        );


    // --------------------------------------------------------
    // Luz ambiental
    // --------------------------------------------------------

    float ambient =
        0.35;


    float lighting =
        ambient +
        diffuse * 0.65;


    // --------------------------------------------------------
    // Color final
    // --------------------------------------------------------

    vec3 finalColor =
        bondColor *
        lighting;


    FragColor =
        vec4(
            finalColor,
            1.0
        );
}