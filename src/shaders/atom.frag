#version 330 core


in vec3 FragPos;
in vec3 Normal;


uniform vec3 atomColor;


out vec4 FragColor;


void main()
{
    // ========================================================
    // Luz
    // ========================================================

    vec3 lightDirection =
        normalize(
            vec3(
                4.0,
                6.0,
                3.0
            )
        );


    // ========================================================
    // Normal
    // ========================================================

    vec3 normal =
        normalize(Normal);


    // ========================================================
    // Difusa
    // ========================================================

    float diffuse =
        max(
            dot(
                normal,
                lightDirection
            ),
            0.0
        );


    // ========================================================
    // Ambiente
    // ========================================================

    float ambient =
        0.25;


    // ========================================================
    // Iluminación final
    // ========================================================

    float lighting =
        ambient +
        diffuse * 0.75;


    // ========================================================
    // Color final
    // ========================================================

    FragColor =
        vec4(
            atomColor * lighting,
            1.0
        );
}