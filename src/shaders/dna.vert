#version 330 core


// ============================================================
// INPUT
// ============================================================

layout(location = 0) in vec2 vertexPosition;

layout(location = 1) in uint base;


// ============================================================
// MATRICES
// ============================================================

uniform mat4 model;

uniform mat4 view;

uniform mat4 projection;


// ============================================================
// PARAMETERS
// ============================================================

uniform float particleRadius;

uniform float particleSpacing;


// ============================================================
// OUTPUT
// ============================================================

flat out uint baseType;

out vec2 localPosition;


// ============================================================
// MAIN
// ============================================================

void main()
{
    // ========================================================
    // Índice
    // ========================================================

    uint id =
        uint(gl_InstanceID);


    // ========================================================
    // Posición
    // ========================================================

    float x =
        float(id) *
        particleSpacing;


    vec3 particlePosition =
        vec3(
            x,
            0.0,
            0.0
        );


    // ========================================================
    // Quad
    // ========================================================

    vec3 offset =
        vec3(
            vertexPosition *
            particleRadius,
            0.0
        );


    vec4 worldPosition =
        model *
        vec4(
            particlePosition + offset,
            1.0
        );


    // ========================================================
    // Transformación
    // ========================================================

    gl_Position =
        projection *
        view *
        worldPosition;


    // ========================================================
    // Datos
    // ========================================================

    baseType =
        base;


    localPosition =
        vertexPosition;
}